# Notion API設定
NOTION_API_TOKEN=your_notion_integration_secret_here
MCP_LOG_PAGE_ID=8a6ce048c8e54b5db4c149a5ff5bb178
# Daily Digest を書き込む Notion データベースの ID（必須）
MCP_LOG_DB_ID=your_daily_digest_database_id_here

# GitHub API設定
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_USERNAME=your_github_username_here

# ActivityWatch設定
AW_API_BASE=http://localhost:5600

# Chrome設定（通常は変更不要）
CHROME_PROFILE=Default

# 端末設定（通常は空のままでよい。空なら OS から Win / Mac を決める）
# DEVICE_NAME=Mac
# 収集対象（カンマ区切り。空なら Win は全部、Mac は activitywatch,whatpulse）
# COLLECTORS=activitywatch,whatpulse
